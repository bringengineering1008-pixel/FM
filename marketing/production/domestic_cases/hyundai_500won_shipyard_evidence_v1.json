      "primary_source_url": "https://www.hhi.co.kr/resources/front/assets/file/%ED%98%84%EB%8C%80%EC%A4%91%EA%B3%B5%EC%97%85%EA%B7%B8%EB%A3%B9_50%EB%85%84%EC%82%AC_1%EA%B6%8C%28%ED%86%B5%EC%82%AC%29.pdf",
